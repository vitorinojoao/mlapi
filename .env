
## Local DNS name; point this name to the Docker host.
ARG_NGINX_DOMAIN=mlapi.home.arpa
ARG_NGINX_IP=127.0.0.1

## Published host port; keep it off the public Internet unless intended.
ARG_NGINX_HTTP_PORT=8080
ARG_NGINX_HTTPS_PORT=8443

## Build arguments for app and db
ARG_APP_PORT=8000
ARG_DB_PORT=5432

## Environmental variables for app
APP_EXTERNAL_URL_1=http://192.0.2.1
APP_EXTERNAL_URL_2=https://example.com
