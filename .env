## Local DNS name of the Docker host.
ARG_NGINX_DOMAIN=mlapi.home.arpa
ARG_NGINX_IP=127.0.0.1

## Published host port; keep it off the public Internet unless intended.
ARG_NGINX_HTTP_PORT=8080
ARG_NGINX_HTTPS_PORT=8443

## Build arguments for dockerfiles
APP_PORT=8000
DB_PORT=5432
CACHE_PORT=6379

## Environmental variables for db-service
DB_AUTH_NAME=db_auth
DB_AUTH_USER=db_auth_user
DB_AUTH_PASSWORD_FILE=/run/secrets/db_auth_password
DB_DATA_NAME=db_data
DB_DATA_USER=db_data_user
DB_DATA_PASSWORD_FILE=/run/secrets/db_data_password

## Environmental variables for app-service
APP_EXTERNAL_URL_1=https://example.com
APP_EXTERNAL_URL_2=http://192.0.2.1

## --------------------
## Filepath from where to load the ML model
API_MODEL_FILEPATH=./resources/classification_model.joblib
## --------------------
## Filepath from where to load the categorical feature encodings
API_CATEGORICAL_ENCODING_FILEPATH=./resources/categorical_feature_encoding.csv
## --------------------
## True to enable the conversion of predictions from confidence scores
## to the label of the class with the highest score
API_CONVERT_CLASS_SCORES=True
## True to enable the conversion of predictions from anomaly scores
## to inliers/outliers from 1/-1 format to 0/1 format
API_CONVERT_ANOMALY_SCORES=False
## --------------------
