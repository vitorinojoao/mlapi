
# Local DNS name; point this name to the Docker host.
ARG_NGINX_DOMAIN=api.home.arpa
# Published host port; keep it off the public Internet unless intended.
ARG_NGINX_HTTP_PORT=80
ARG_NGINX_HTTPS_PORT=443

# App build arguments
ARG_APP_PORT=8000
# ARG_APP_WORKERS=3
# ARG_APP_TIMEOUT=30
# ARG_APP_GRACEFUL=10

# App environmental variables
APP_CALL_URL_1=http://192.0.2.1
APP_CALL_URL_2=https://example.com
